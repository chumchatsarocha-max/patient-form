# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง — .env.local ถูก gitignore ไว้
# ค่าเหล่านี้เป็น NEXT_PUBLIC_* จึงถูกฝังลงใน bundle ฝั่ง client (ตั้งใจ — client ต้องต่อ WebSocket เอง)
#
# PROJECT_SPEC.md §9: ใช้ได้เฉพาะ publishable / anon key เท่านั้น
# ห้ามใส่ secret หรือ service_role key ที่นี่หรือที่ใดก็ตามในโค้ดฝั่ง client เด็ดขาด
# คีย์ที่ถูกต้องขึ้นต้นด้วย `sb_publishable_` (แบบใหม่) หรือเป็น anon JWT (แบบเดิม)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ประตูกั้นหน้า staff แบบ demo — ตรวจฝั่ง server เท่านั้น ไม่ใช่ NEXT_PUBLIC
# ไม่ตั้งก็ได้ จะใช้ค่า default Admin / Admin@12345 (ระบุไว้ใน README)
STAFF_USERNAME=Admin
STAFF_PASSWORD=Admin@12345
